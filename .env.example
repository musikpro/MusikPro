# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local sandbox webhooks: set this to the current ngrok HTTPS URL. Keep NEXT_PUBLIC_APP_URL on localhost.
PAYMENT_WEBHOOK_BASE_URL=
DEFAULT_COUNTRY=CI
APP_NAME=Africa SaaS Kit

# Neon PostgreSQL
DATABASE_URL=
# Optional but recommended for Drizzle migrations: direct (non-pooled) Neon connection.
DATABASE_URL_DIRECT=

# Better Auth
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Auth mode / Resend
# If email/password auth is enabled in production, Resend is required.
AUTH_EMAIL_PASSWORD_ENABLED=true
AUTH_REQUIRE_EMAIL_VERIFICATION=true
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
SUPPORT_EMAIL=musikpro2026@gmail.com

# Payments — OPTIONAL, configure only in Phase 16 with `npm run payments:setup`
PAYMENT_DEFAULT_PROVIDER=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Africa payment adapters
# Chariow: configure API key, webhook secret, and map each SaaS plan to a published Chariow product ID in Admin.
CHARIOW_API_KEY=
CHARIOW_WEBHOOK_SECRET=
DJOMY_API_KEY=
DJOMY_API_SECRET=
PAYDUNYA_ENVIRONMENT=sandbox
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
FLUTTERWAVE_ENVIRONMENT=sandbox
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
MONEROO_API_KEY=
MONEROO_WEBHOOK_SECRET=
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENVIRONMENT=test
BICTORYS_API_KEY=
BICTORYS_WEBHOOK_SECRET=
BICTORYS_ENVIRONMENT=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# Google / SEO
# Search Console HTML meta verification value (content only, not the full meta tag)
GOOGLE_SITE_VERIFICATION=
# Google Cloud OAuth Web Client for Better Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Optional: enable Search Console API only when you explicitly request OAuth scope webmasters.readonly
GOOGLE_SEARCH_CONSOLE_ENABLED=false

# Cloudinary image uploads — OPTIONAL, configure only in Phase 18 with `npm run cloudinary:setup`
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=africa-saas-kit

# OpenAI lyrics — OPTIONAL. Never expose these through NEXT_PUBLIC_*.
# Required only when the owner stores/replaces the API key from the dashboard:
# openssl rand -base64 32
APP_SECRETS_ENCRYPTION_KEY=
# Optional server fallback when no encrypted dashboard key is stored.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-terra
OPENAI_MAX_OUTPUT_TOKENS=4000
# Optional Anthropic fallback when no encrypted Claude dashboard key is stored.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_OUTPUT_TOKENS=4000

# Musicful audio generation — OPTIONAL. Configure from /admin/ai-providers/audio instead when possible.
# Optional server fallback when no encrypted dashboard key is stored.
MUSICFUL_API_KEY=

# Twilio SMS — secrets are entered in the owner dashboard and encrypted at rest.
# Generate with: openssl rand -base64 32

# Optional infrastructure / security
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Reserved / not wired in V0.8.9 (setting these alone has no effect)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
INNGEST_EVENT_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Security: standard | high | maximum
SECURITY_LEVEL=high
# Temporary owner login switch. Set to true when owner 2FA is reactivated.
OWNER_2FA_ENABLED=false

# Dedicated demo deployment only. Never enable these on the real SaaS deployment.

# Web setup is hard-disabled in production in V0.8.2. No production setup token is supported.

# Cron reconciliation — generate a long random secret in production
CRON_SECRET=
# Optional generation-time schedule for `npm run cron:generate` (default hourly)
PAYMENT_RECONCILE_CRON=

# Public branding / SEO (public values only)
NEXT_PUBLIC_APP_NAME="Africa SaaS Kit"
NEXT_PUBLIC_APP_DESCRIPTION="Starter SaaS Next.js mobile-first adapté à l'Afrique."
NEXT_PUBLIC_APP_LANGUAGE=fr
NEXT_PUBLIC_APP_LOCALE=fr_CI

# Separate restricted server job/admin connection (never the migration owner)
DATABASE_SERVICE_URL=
