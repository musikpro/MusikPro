<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Microphone : transcription vocale de l'histoire de la chanson (écran « Raconte ton histoire »). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Le micro n'est pas indispensable : l'application reste installable sur un appareil sans micro. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Pochette de chanson : choisir une image dans la galerie ou en prendre une avec l'appareil photo. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Aucune autorisation de lecture des photos : le sélecteur du système (Photo Picker / Documents) donne l'accès
         à la seule image choisie, ce qui évite aussi la déclaration « photos et vidéos » exigée par Google Play. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Téléchargement d'une chanson (MP3) dans « Téléchargements » : le DownloadManager n'a besoin d'aucune autorisation
         depuis Android 10 ; elle n'est demandée que sur Android 7 à 9. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Android 11+ : permet à la WebView de trouver le service de reconnaissance vocale du téléphone. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Android 11+ : sans cette déclaration l'application ne voit pas l'appareil photo du téléphone et le champ
             photo (capture) retombe silencieusement sur la galerie. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
