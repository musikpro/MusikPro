{
  "version": 1,
  "policy": "Every app/api route must be classified. A new route fails security:baseline until authentication, server validation and rate limiting are explicitly declared.",
  "routes": {
    "app/api/auth/[...all]/route.ts": {
      "auth": "better-auth-framework",
      "validation": "framework-owned",
      "rateLimit": "better-auth-database",
      "markers": ["toNextJsHandler(auth)"]
    },
    "app/api/cron/reconcile-payments/route.ts": {
      "auth": "cron-secret",
      "validation": "no-user-body",
      "rateLimit": "scheduler-exempt",
      "markers": ["verifyCronRequest(request)"]
    },
    "app/api/cron/funnel-retention/route.ts": {
      "auth": "cron-secret",
      "validation": "no-user-body",
      "rateLimit": "scheduler-exempt",
