  "opacity": {
    "createIconBackground": 0.2,
    "createSubtitle": 0.8,
    "createChevron": 0.7,
    "accentBorder": 0.2,
    "downloadGradientStart": 0.1,
    "imageOverlayMobile": 0.6,
    "imageOverlayDesktop": 0.7,
    "imageMetadata": 0.7
  },
  "layout": {
    "desktopBreakpointPx": 1100,
    "tabletStartPx": 768,
    "tabletContentMaxPx": 540,
    "sidebarPx": 240,
    "rightColumnPx": 320,
    "desktopHeaderPx": 64,
    "mobileGutterPx": 16,
    "compactGutterPx": 12,
    "bottomNavigation": {
      "position": "fixed",
      "zIndex": 50,
      "sideInsetPx": 16,
      "bottomInsetPx": 16,
      "reservedSpacePx": 110,
      "safeArea": "env(safe-area-inset-bottom, 0px)",
      "tabletWidthPx": 508
    }
  },
  "authority": {
    "newBananiScreen": "screen-specific-source-of-truth",
    "missingDetail": "use-observed-common-tokens",
    "unobservedStates": "must-not-be-described-as-imported"
  },
  "modernization": {
    "status": "user-requested-refresh",
    "date": "2026-09-18",
    "scope": ".musik-modern",
    "mutedForeground": "#736a62",
    "heroGradient": ["#b83d13", "#ed6826", "#f69962"],
    "shadow": "0 8px 28px rgb(70 43 23 / 6%), 0 1px 3px rgb(70 43 23 / 4%)",
    "raisedShadow": "0 16px 40px rgb(70 43 23 / 12%)",
    "motion": {
      "revealMs": 350,
      "cardEntryMs": 400,
      "hoverMs": 220,
      "reducedMotion": "disabled"
    },
    "navigationBlurPx": 20
  },
  "desktopWorkspace": {
    "status": "dashboard-derived-user-requested",
    "breakpointPx": 1024,
    "sidebarWidthPx": [210, 230],
    "contextWidthPx": [220, 260],
    "pageCardRadiusPx": 28,
    "columnsGapPx": [20, 24],
    "settingsGridBreakpointPx": 1280,
    "songGridBreakpointPx": 1440,
    "sidebarBehavior": {
      "overflow": "visible",
      "scrollbar": "hidden",
      "stickyTop": "min(0, viewportHeight - menuHeight)",
      "background": "input",
      "resize": "ResizeObserver and window resize"
    }
  },
  "updatedAt": "2026-09-19",
  "semanticColors": {
    "success": "#22c55e",
    "successStrong": "#16844b",
    "danger": "#dc2626",
    "warning": "#d97706",
    "info": "#2563eb",
    "focus": "#f26522"
  },
  "controls": {
    "touchTargetMinPx": 44,
    "fieldHeightPx": 48,
    "searchHeightPx": 56,
    "fieldRadiusPx": [13, 16],
    "mobileInputFontMinPx": 16,
    "focus": {
      "color": "primary",
      "widthPx": 2,
      "haloPx": 3,
      "rule": "single visible indicator; never outline plus container ring"
    },
    "errors": {
      "placement": "directly below related field",
      "dismissibleDemoMs": 4200
    },
    "readOnly": {
      "focusable": false,
      "surface": "muted"
    }
  },
  "selects": {
    "primitive": "MusikSelect",
    "nativeBrowserMenu": false,
    "defaultWidth": "trigger width",
    "portalWhenClipped": true,
    "variants": {
      "language": "flags only, centered, no inner cards",
      "currency": "trigger and menu same width, right-aligned, no selection mark",
      "relation": "full width, scrollable without closing",
      "phonePrefix": "flag and dialing prefix only"
    }
  },
  "cards": {
    "standard": {
      "radiusPx": [14, 20],
      "paddingPx": [16, 20],
      "surface": "card",
      "shadow": "card"
    },
    "page": {
      "radiusPx": [24, 28],
      "surface": "card"
    },
    "featured": {
      "radiusPx": [19, 32],
      "surface": "primary-to-coral gradient",
      "shadow": "primary"
    },
    "help": {
      "surface": "surface or softened secondary",
      "icon": "functional"
    }
  },
  "buttons": {
    "primary": {
      "heightPx": [48, 52],
      "radiusPx": [13, 16],
      "weight": [700, 800]
    },
    "secondary": {
      "minHeightPx": 44
    },
    "iconOnly": {
      "sizePx": [40, 44],
      "accessibleName": true
    },
    "destructive": {
      "color": "danger",
      "confirmationRequired": true
    }
  },
  "selection": {
    "pressedAttribute": "aria-pressed",
    "surface": "secondary",
    "border": "primary",
    "mark": "functional check when composition allows",
    "packs": {
      "grid": "2x2 all viewports",
      "singleSelection": true,
      "popularBadgeSeparateFromSongCount": true
    }
  },
  "creationFlow": {
    "steps": 8,
    "topNavigation": {
      "items": ["back", "dashboard", "step"],
      "scrollsWithPage": true,
      "sideWidthPx": {
        "default": 96,
        "compact": 68
      },
      "centerMinWidthPx": {
        "default": 135,
        "compact": 145
      }
    },
    "mobileCta": {
      "position": "fixed",
      "safeArea": true,
      "actions": ["continue", "generate lyrics", "generate song"]
    },
    "hideBottomNavigation": true
  },
  "mobileNavigation": {
    "bottom": {
      "position": "fixed",
      "maxItems": 5,
      "sideInsetPx": 16,
      "bottomInsetPx": 16,
      "reservedSpacePx": 110,
      "safeArea": true
    },
    "drawer": {
      "side": "left",
      "width": "min(86vw, 330px)",
      "backdrop": true,
      "escapeClose": true,
      "lockBodyScroll": true,
      "animationMs": 220
    }
  },
  "contentRules": {
    "currencyLabels": ["FCFA (XOF)", "Euro (€)", "Dollar ($)", "Naira (₦)"],
    "packUnit": "songs",
    "creditTerminologyAllowed": false,
    "paymentLogos": "official assets only when authorized",
    "demoData": "must never be presented as production data"
  },
  "feedbackStates": ["loading", "empty", "error", "success", "disabled", "unauthorized", "offline", "pending"],
  "ownerDashboard": {
    "inheritsClientDesignSystem": true,
    "desktopSidebarPx": 240,
    "headerHeightPx": [64, 76],
    "mobileNavigation": "left drawer",
    "tables": "cards when practical, otherwise localized horizontal scroll",
    "kpiCard": "standard card + functional icon + value + label + semantic delta",
    "duplicateBananiVariants": {
      "packs": "one route",
      "funnel": "one route"
    },
    "mobileFirstViewportsPx": [320, 360, 390, 430, 768, 1024, 1440],
    "serverAuthorization": "requireAdmin"
  }
}
