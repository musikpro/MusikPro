  "spacingPx": [2, 4, 6, 8, 10, 12, 16, 20, 24, 32],
  "shadows": {
    "song": "0 1px 8px rgba(0,0,0,0.06)",
    "create": "0 4px 20px rgba(242,101,34,0.35)",
    "bottomNavigation": "0 4px 24px rgba(0,0,0,0.10)",
    "centralAction": "0 4px 16px rgba(242,101,34,0.40)",
    "card": "0 8px 28px rgb(70 43 23 / 6%), 0 1px 3px rgb(70 43 23 / 4%)",
    "raised": "0 16px 40px rgb(70 43 23 / 12%)",
    "primary": "0 9px 20px rgb(242 101 34 / 24%)",
    "drawer": "24px 0 60px rgb(32 22 17 / 26%)"
