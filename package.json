    "mobile:app:configure": "node scripts/mobile-app-configure.mjs",
    "mobile:app:install": "node scripts/mobile-app-install.mjs",
    "mobile:app:prepare": "node scripts/mobile-app-prepare.mjs",
    "mobile:app:check": "node scripts/mobile-app-check.mjs",
